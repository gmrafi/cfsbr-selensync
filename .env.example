# ==============================================================================
# SelenSync - Environment Configuration (Open Access & Public APIs)
# ==============================================================================

# NASA Open APIs
# Get your free NASA API key at: https://api.nasa.gov/ (or use "DEMO_KEY")
NEXT_PUBLIC_NASA_API_KEY=DEMO_KEY
NASA_API_KEY=DEMO_KEY

# NASA Earthdata / CMR Token (Optional for imagery downlinks)
# Get a free token at: https://urs.earthdata.nasa.gov/
NASA_EARTH_DATA_TOKEN=

# AI Reasoning Engines (Afshara - AI Lunar Mission Strategist)
# Free Groq API Key: https://console.groq.com/
GROQ_API_KEY=

# Google Gemini API Key (Fallback): https://aistudio.google.com/
GOOGLE_GEMINI_API_KEY=

# Mapbox Access Token (Optional for 3D Earth/Lunar globe maps)
# Get free token at: https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# App URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
